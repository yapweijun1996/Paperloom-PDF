{
  "name": "paperloom-pdf",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24.0.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "predev": "node scripts/prepare-ocr-assets.mjs",
    "dev": "next dev --webpack",
    "prebuild": "node scripts/prepare-ocr-assets.mjs",
    "build": "next build --webpack && node scripts/prepare-pwa.mjs",
    "verify:pdf-worker": "node scripts/verify-pdf-worker.mjs",
    "verify:base-path": "node scripts/verify-base-path.mjs",
    "lint": "eslint",
    "test": "node --test scripts/e2e-static-preflight.test.mjs && vitest run",
    "test:e2e": "playwright test --config=playwright.config.mjs",
    "test:coverage": "node scripts/verify-test-tools.mjs && vitest run --coverage",
    "test:watch": "vitest",
    "verify:browser-only": "node scripts/verify-browser-only.mjs",
    "verify:browser-core": "node scripts/verify-browser-core.mjs",
    "verify:release": "node scripts/verify-release.mjs",
    "pretest": "node scripts/verify-test-tools.mjs"
  },
  "dependencies": {
    "@noble/hashes": "2.4.0",
    "@pdf-lib/upng": "^1.0.1",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-slider": "^1.3.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-tooltip": "^1.2.8",
    "asn1js": "4.0.0",
    "clsx": "^2.1.1",
    "fabric": "^7.4.0",
    "harfbuzzjs": "^1.6.3",
    "lucide-react": "^1.16.0",
    "next": "16.2.11",
    "pdf-lib": "^1.17.1",
    "pkijs": "4.0.1",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-dropzone": "^15.0.0",
    "react-signature-canvas": "^1.1.0-alpha.2",
    "saxes": "6.0.0",
    "tailwind-merge": "^3.6.0",
    "tesseract.js": "^7.0.0",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@napi-rs/canvas": "^0.1.100",
    "@playwright/test": "1.55.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/react-signature-canvas": "^1.0.7",
    "@vitest/coverage-istanbul": "3.2.7",
    "esbuild": "0.28.1",
    "eslint": "^9",
    "eslint-config-next": "16.2.11",
    "happy-dom": "^20.10.6",
    "parse5": "^7.3.0",
    "tailwindcss": "^4",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  },
  "description": "Browser-based PDF editor",
  "license": "Apache-2.0"
}
